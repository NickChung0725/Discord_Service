BOT_TOKEN=your_discord_bot_token_here

# 你的伺服器 ID
GUILD_ID=1557751571205333082
# gcp-vm-server 文字頻道 ID
GCP_VM_SERVER_CHANNEL_ID=1558122364062015570
# 想定時推播的文字頻道 ID
ANNOUNCE_CHANNEL_ID=1557751571742330892
STOCK_CHANNEL_ID=1557778164124622918
# 19:00 MA 均線排列訊號與 20:50 型態 A 反彈清單推播頻道 ID (alignment_signals)
ALIGNMENT_SIGNALS_CHANNEL_ID=1566830891299508426

FINMIND_API_TOKEN=your_finmind_api_token_here

GITHUB_TOKEN=github_pat_your_token_here
GITHUB_REPO=NickChung0725/Discord_Service
GITHUB_BRANCH=gh-pages

# AI 模型分級設定（全系統統一 3 級：Base / 中級 / 高級）
AI_MODEL_BASE=gemini-flash-lite-latest
AI_MODEL_MID=gemini-4-hydrogen
AI_MODEL_HIGH=gemini-4-neon

# Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud / Vertex AI (AI 模型呼叫一律使用 global，BigQuery 才是使用 us-central1)
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_LOCATION=global
BQ_LOCATION=us-central1
VERTEX_API_KEY=your_vertex_api_key_here

# Vertex AI Batch 與 BigQuery 設定
VERTEX_BATCH_ENABLED=true
BQ_STAGING_DATASET=vertex_batch_staging
BQ_PERM_DATASET=discord_service
BQ_PERM_TABLE=ai_prompt_logs
BQ_LOG_ENABLED=true
VERTEX_BATCH_POLL_SECONDS=60
VERTEX_BATCH_TIMEOUT_SECONDS=7200

# Google Sheets /stock_ai cache
GOOGLE_APPLICATION_CREDENTIALS=/certs/sheetbot.json
GSHEET_SPREADSHEET_ID=

# /stock_ai window & cooldown
FINMIND_PROBE_COOLDOWN_HOURS=6
AI_WINDOW_QUARTERS=8
AI_WINDOW_MONTHS=12
CHART_WINDOW_QUARTERS=16
CHART_WINDOW_MONTHS=36

# 6. 台新證券 Nova API 與個人帳務中心設定
TAISHIN_PERSON_ID=你的身分證字號
TAISHIN_PASSWORD=你的台新登入密碼
TAISHIN_CERT_PASSWORD=你的憑證密碼
TAISHIN_CERT_PATH=certs/taishin_cert.pfx
TAISHIN_ACCOUNT_NO=

# 個人對帳單與庫存專屬 Google Sheet ID (與公用財報 GSHEET_SPREADSHEET_ID 徹底分離)
TAISHIN_GSHEET_SPREADSHEET_ID=你的個人帳務専用_Google_Sheet_ID

# 帳務與持股健診推播頻道 ID (若未填則 fallback 至 STOCK_CHANNEL_ID)
TAISHIN_ALERT_CHANNEL_ID=1566338807085670401

# 交易安全開關與 0050 每週不定期定額設定 (預設 false 僅推播訊號不真下單)
TAISHIN_ENABLE_TRADING=false
DCA_0050_WEEKLY_BUDGET_TWD=10000
