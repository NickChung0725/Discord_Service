BOT_TOKEN=your_discord_bot_token_here


GUILD_ID = your_discord_guild_id       # 你的伺服器 ID
ANNOUNCE_CHANNEL_ID = your_discord_announce_channel_id  # 想定時推播的文字頻道 ID
STOCK_CHANNEL_ID=your_discord_stock_channel_id

FINMIND_API_TOKEN=your_finmind_api_token_here

GITHUB_TOKEN=github_pat_your_token_here
GITHUB_REPO=username/repo_name
GITHUB_BRANCH=gh-pages

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Google Sheets /stock_ai cache
GOOGLE_APPLICATION_CREDENTIALS=/home/your-user/Discord_Service/service_account.json
GSHEET_SPREADSHEET_ID=

# /stock_ai window & cooldown
FINMIND_PROBE_COOLDOWN_HOURS=6
AI_WINDOW_QUARTERS=8
AI_WINDOW_MONTHS=12
CHART_WINDOW_QUARTERS=16
CHART_WINDOW_MONTHS=36